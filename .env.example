# Copy to .env (never commit .env).
GATEWAY_PORT=8180

# Mapbox public token (pk.*). Empty = map placeholder.
VITE_MAPBOX_TOKEN=

# Host port for DB tools, bound to 127.0.0.1 only.
DB_PORT=15432

POSTGRES_DB=heatscape
POSTGRES_USER=heatscape
POSTGRES_PASSWORD=change-me

# Sign-in users (MOCK until Keycloak). Admin opens /admin; planner is the non-admin check.
# Empty password = that user cannot sign in. These are local dev passwords (committed
# here on purpose); set your own in .env for any shared or public deployment.
ADMIN_EMAIL=admin@heatscape.local
ADMIN_PASSWORD=Hs-Admin-ff0a42dd
PLANNER_EMAIL=planner@heatscape.local
PLANNER_PASSWORD=Hs-Planner-bfb673c8
